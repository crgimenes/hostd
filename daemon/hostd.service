[Unit]
Description=hostd control plane
Documentation=https://github.com/crgimenes/hostd
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/hostd
Restart=always
RestartSec=1s

# A belt that no longer holds anything up, kept because it costs nothing and
# because taking it out is a decision about a machine that is running.
#
# It was load-bearing when hostd supervised processes itself: they were its
# children, in this unit's cgroup, and the default kill mode would have taken
# them down with it. Supervision moved to the runtime, and containers are now
# dockerd's — measured on yuki, hostd's cgroup holds one process, its own, and
# a container sits in /system.slice/docker-<id>.scope. Restarting this unit
# cannot reach them whatever the kill mode says.
#
# What actually keeps the work alive across an upgrade is that nothing here
# owns it: the runtime does. `hostctl install` checks that, rather than
# trusting this line to mean what it used to.
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=30s

# hostd owns these and creates them itself; listing them here means systemd
# creates them with the right ownership before the daemon starts.
StateDirectory=hostd
StateDirectoryMode=0700
RuntimeDirectory=hostd
RuntimeDirectoryMode=0700
ConfigurationDirectory=hostd
ConfigurationDirectoryMode=0700

[Install]
WantedBy=multi-user.target
