{{define "page"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>hostd</title>
<link rel="stylesheet" href="/asset/app.css">
</head>
<body>
<div id="shell">
  <nav id="sidebar" aria-label="fleet">
    {{.tree}}
    <footer id="sidebarFoot">{{.status}}</footer>
  </nav>
  <div id="grip" role="separator" aria-orientation="vertical" tabindex="-1"></div>

  <section id="pane">
    {{.detail}}

    <div id="split" role="separator" aria-orientation="horizontal" tabindex="-1"></div>

    <section id="console">
      <header>
        <h2>Log</h2>
        <input type="search" id="filter" placeholder="Filter" spellcheck="false">
        <label id="followLabel"><input type="checkbox" id="follow" checked> Follow</label>
      </header>
      <ol id="lines">{{range .lines}}<li data-seq="{{.Seq}}"{{if .Class}} class="{{.Class}}"{{end}}><span class="when">{{.When}} </span><span class="where">{{.Where}} </span><span class="text">{{.Text}}</span></li>{{end}}</ol>
    </section>
  </section>
</div>

<dialog id="command">
  <h3 id="commandTitle">The panel does not change anything</h3>
  <p id="commandNote">Run this where you keep your tree:</p>
  <code id="commandText"></code>
  <div class="actions">
    <button id="dismiss">Close</button>
    <button id="copy" class="default">Copy</button>
  </div>
</dialog>

<script src="/asset/app.js"></script>
</body>
</html>{{end}}

{{define "tree"}}<ol id="tree" role="tree">
{{- range .Rows}}
<li><div class="row{{if .Child}} child{{else}} machine{{end}}{{if .Selected}} selected{{end}}" role="treeitem"
    {{- if .Link}} data-act="{{.Link}}"{{end}}>
  {{- if .Twist}}<span class="twist {{.Twist}}" data-act="{{.Toggle}}">&#9654;</span>
  {{- else}}<span class="twist"></span>{{end}}
  {{- if .Dot}}{{template "treeDot" .}}{{end}}
  <span class="name">{{.Label}}</span>
  {{- if .Meta}}{{template "treeMeta" .}}{{end}}
</div></li>
{{- end}}
</ol>{{end}}

{{define "treeDot"}}<span id="{{.DotID}}" class="dot {{.Dot}}"></span>{{end}}
{{define "treeMeta"}}<span id="{{.MetaID}}" class="meta">{{.Meta}}</span>{{end}}

{{define "status"}}<span id="status"{{if .Bad}} class="bad"{{end}}>{{.Text}}</span>{{end}}

{{define "detail"}}<div id="detail">
  <header id="toolbar">
    <div id="crumb">
      <h1 id="title">{{.Title}}</h1>
      <p id="subtitle">{{.Subtitle}}</p>
    </div>
    <div id="controls">
      <span id="range"{{if not .Frozen}} hidden{{end}}><span id="rangeText">{{.RangeText}}</span><button id="rangeReset" data-act="range/live">live</button></span>
      <div id="windows" role="group" aria-label="window">
        {{- $window := .Window}}{{$frozen := .Frozen}}
        <button data-act="window/300"{{if and (eq $window 300) (not $frozen)}} class="on"{{end}}>5m</button>
        <button data-act="window/3600"{{if and (eq $window 3600) (not $frozen)}} class="on"{{end}}>1h</button>
        <button data-act="window/21600"{{if and (eq $window 21600) (not $frozen)}} class="on"{{end}}>6h</button>
        <button data-act="window/86400"{{if and (eq $window 86400) (not $frozen)}} class="on"{{end}}>24h</button>
      </div>
    </div>
  </header>
  <div id="content" data-from="{{.From}}" data-to="{{.To}}">
    {{- if .Empty}}<p class="empty">{{.Empty}}</p>{{end}}
    <div class="cards{{if .Single}} single{{end}}">
    {{- range .Cards}}
      <section class="card{{if .Link}} machineCard{{end}}"{{if .Link}} data-act="{{.Link}}"{{end}}>
        <h2><span>{{.Heading}}</span>{{if .Aside}}{{template "cardAside" .}}{{end}}
          {{- if .Buttons}}<span class="headActions">{{range .Buttons}}<button class="push" data-command="{{.Command}}">{{.Label}}</button>{{end}}</span>{{end}}</h2>
        {{- if .Problem}}<p class="problem">{{.Problem}}</p>{{end}}
        {{- if .Numbers}}{{template "statBlock" .}}{{end}}
        {{- if .Head}}
        <table class="services">
          <tr>{{range .Head}}<th>{{.}}</th>{{end}}</tr>
          {{- range .Rows}}
          <tr>
            <td data-act="{{.Link}}">{{.Name}}</td>
            {{template "rowPill" .}}
            <td class="dim">{{.Image}}</td>
            {{template "rowUptime" .}}
            {{template "rowRestarts" .}}
            <td class="actions">{{range .Buttons}}<button class="push" data-command="{{.Command}}">{{.Label}}</button>{{end}}</td>
          </tr>
          {{- if .Problem}}<tr><td class="wide problem" colspan="6">{{.Problem}}</td></tr>{{end}}
          {{- end}}
          {{- if not .Rows}}<tr><td class="dim">no service is declared here</td></tr>{{end}}
        </table>
        {{- end}}
        {{- if .Facts}}{{template "factsTable" .}}{{end}}
        {{- range .Charts}}{{template "chartHolder" .}}{{end}}
      </section>
    {{- end}}
    </div>
  </div>
</div>{{end}}

{{define "cardAside"}}<span id="{{.AsideID}}" class="aside">{{.Aside}}</span>{{end}}

{{define "statBlock"}}<div id="{{.StatID}}" class="stat">{{range .Numbers}}<div><span class="value">{{.Value}}</span><span class="of">{{.Of}}</span></div>{{end}}</div>{{end}}

{{define "factsTable"}}<table id="{{.FactsID}}" class="facts">{{range .Facts}}<tr><td class="dim">{{index . 0}}</td><td class="wide">{{index . 1}}</td></tr>{{end}}</table>{{end}}

{{define "rowPill"}}<td id="{{.PillID}}"><span class="pill"><span class="dot {{.Dot}}"></span><span>{{.State}}</span></span></td>{{end}}
{{define "rowUptime"}}<td id="{{.UpID}}"{{if not .Job}} data-since="{{.Since}}"{{end}}>-</td>{{end}}
{{define "rowRestarts"}}<td id="{{.RstID}}">{{.Restart}}</td>{{end}}

{{define "chartHolder"}}<div id="{{.ID}}" class="plotHolder">
  <div class="legend">{{range .Legend}}<span class="key"><span class="swatch" style="background:{{.Colour}}"></span><span>{{.Label}} {{.Value}}</span></span>{{end}}</div>
  <div class="plot{{if .Short}} short{{end}}">
    <span class="readout">{{.Top}}</span>
    <svg viewBox="0 0 1000 100" preserveAspectRatio="none">{{.Body}}</svg>
  </div>
</div>{{end}}

{{define "newLines"}}<ol data-swap="append:#lines">{{range .}}<li data-seq="{{.Seq}}"{{if .Class}} class="{{.Class}}"{{end}}><span class="when">{{.When}} </span><span class="where">{{.Where}} </span><span class="text">{{.Text}}</span></li>{{end}}</ol>{{end}}

{{define "allLines"}}<ol id="lines">{{range .}}<li data-seq="{{.Seq}}"{{if .Class}} class="{{.Class}}"{{end}}><span class="when">{{.When}} </span><span class="where">{{.Where}} </span><span class="text">{{.Text}}</span></li>{{end}}</ol>{{end}}
